{
  // The FastEmu site: static files in ./public, served by a Worker with no code.
  // Build them first with `npm ci && node build.mjs`, then `npx wrangler deploy`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fastemu-site",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    // Unknown paths get public/404.html with a 404 status.
    "not_found_handling": "404-page"
  },
  // The site lives on its own domain only: no *.workers.dev address and no
  // preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "fastemu.functionx.dev",
      "custom_domain": true
    }
  ]
}
