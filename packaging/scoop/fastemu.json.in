{
    "version": "@VERSION@",
    "description": "Java ME emulator that runs many games at once in one window",
    "homepage": "https://fastemu.functionx.dev",
    "license": "GPL-3.0-or-later",
    "notes": "FastEmu keeps its library, saves and settings in %APPDATA%\\FastEmu, which uninstalling leaves.",
    "architecture": {
        "64bit": {
            "url": "https://github.com/fzn0x/FastEmu/releases/download/v@VERSION@/fastemu-@VERSION@-windows-x64-portable.zip",
            "hash": "@ZIP_SHA256@",
            "extract_dir": "fastemu-@VERSION@-windows-x64"
        }
    },
    "bin": "fastemu.com",
    "shortcuts": [
        [
            "fastemu.exe",
            "FastEmu"
        ]
    ],
    "checkver": {
        "github": "https://github.com/fzn0x/FastEmu"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/fzn0x/FastEmu/releases/download/v$version/fastemu-$version-windows-x64-portable.zip",
                "extract_dir": "fastemu-$version-windows-x64"
            }
        },
        "hash": {
            "url": "https://github.com/fzn0x/FastEmu/releases/download/v$version/SHA256SUMS",
            "regex": "$sha256\\s+\\*?$basename"
        }
    }
}
